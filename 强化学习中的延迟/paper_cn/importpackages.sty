%=============================================
% Code to check if file for a plot exists
%---------------------------------------------
% https://tex.stackexchange.com/questions/412891/does-latex-have-error-catching-capabilities
\usepackage{xparse}
\ExplSyntaxOn
\NewDocumentCommand { \includemyplot } { m }
    {
        \file_if_exist:nTF { #1 }
            {
                \input{#1}
            }
            {
                % maybe issue a warning in the log
            }
    }
\ExplSyntaxOff


