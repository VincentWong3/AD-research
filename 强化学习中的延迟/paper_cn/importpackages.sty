% Reference to a page in plot project
%---------------------------------------------
% https://tex.stackexchange.com/questions/31485/includegraphicspage-pageref-possible-how-to-set-page-to-a-variable
\usepackage[xr]{zref}
%\usepackage{xr-hyper}
\zexternaldocument[tikz:]{img/output}
\zexternaldocument[belief:]{img/output_belief}
\zexternaldocument[imitation:]{img/output_imitation}
\zexternaldocument[lifelong:]{img/output_lifelong}
\zexternaldocument[lifelongvasicek:]{img/output_lifelong_vasicek}
\zexternaldocument[lifelongtrading:]{img/output_lifelong_trading}
